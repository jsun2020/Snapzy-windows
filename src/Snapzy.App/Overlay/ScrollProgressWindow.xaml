<Window x:Class="Snapzy.App.Overlay.ScrollProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="#FF202020"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#F0202020" CornerRadius="6" BorderBrush="#50FFFFFF" BorderThickness="1" Padding="12,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="ProgressText" Foreground="White" FontSize="12" VerticalAlignment="Center" />
            <Button x:Name="BtnCancel" Click="OnCancel" Margin="10,0,0,0" Padding="8,2"
                    Background="#30FFFFFF" Foreground="White" BorderBrush="#50FFFFFF" />
        </StackPanel>
    </Border>
</Window>
