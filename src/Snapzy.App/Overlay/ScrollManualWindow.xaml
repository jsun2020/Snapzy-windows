<Window x:Class="Snapzy.App.Overlay.ScrollManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="#FF202020"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#F0202020" CornerRadius="6" BorderBrush="#50FFFFFF" BorderThickness="1" Padding="12,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Foreground="White" FontSize="12" VerticalAlignment="Center"
                       MaxWidth="330" TextTrimming="CharacterEllipsis" />
            <Button x:Name="BtnAuto" Click="OnAuto" Margin="10,0,0,0" Padding="8,2" Focusable="False"
                    Background="#30FFFFFF" Foreground="White" BorderBrush="#50FFFFFF" />
            <Button x:Name="BtnSave" Click="OnSave" Margin="6,0,0,0" Padding="8,2" Focusable="False"
                    Background="#3034C759" Foreground="White" BorderBrush="#8034C759" FontWeight="SemiBold" />
            <Button x:Name="BtnCancel" Click="OnCancel" Margin="6,0,0,0" Padding="8,2" Focusable="False"
                    Background="#30FFFFFF" Foreground="White" BorderBrush="#50FFFFFF" />
        </StackPanel>
    </Border>
</Window>
