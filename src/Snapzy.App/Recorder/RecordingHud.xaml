<Window x:Class="Snapzy.App.Recorder.RecordingHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#F0202020" CornerRadius="6" BorderBrush="#50FFFFFF" BorderThickness="1" Padding="10,6">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="RedDot" Width="10" Height="10" Fill="#FFE53935" VerticalAlignment="Center" />
            <TextBlock x:Name="TimerText" Text="00:00" Foreground="White" FontFamily="Consolas" FontSize="14"
                       Margin="8,0" VerticalAlignment="Center" />
            <Button x:Name="BtnPause" Click="OnPauseResume" Margin="4,0" Padding="8,2"
                    Background="#30FFFFFF" Foreground="White" BorderBrush="#50FFFFFF" />
            <Button x:Name="BtnStop" Click="OnStop" Margin="2,0" Padding="8,2"
                    Background="#FFB71C1C" Foreground="White" BorderBrush="#50FFFFFF" />
        </StackPanel>
    </Border>
</Window>
